    {
      "name": "L3-SEC-15 — Security headers (A05)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// NFR-SEC01: phản hồi phải có HSTS, X-Content-Type-Options, X-Frame-Options",
              "// và KHÔNG lộ banner phiên bản máy chủ.",
              "pm.test('Có header X-Content-Type-Options: nosniff', function () {",
              "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
              "});",
              "pm.test('Có header X-Frame-Options (chống clickjacking)', function () {",
              "    pm.expect(pm.response.headers.has('X-Frame-Options')).to.be.true;",
              "});",
              "pm.test('HSTS: co tren HTTPS, dung chuan la KHONG gui tren HTTP thuan', function () {",
              "    // RFC 6797 §7.2: user agent PHAI bo qua Strict-Transport-Security nhan qua HTTP thuan, nen",
              "    // SecurityHeadersMiddleware chi gan header nay khi Request.IsHttps. Chay local qua",
              "    // http://localhost:5080 thi khong co header la ĐUNG; chay tren staging https:// thi phai co.",
              "    var https = pm.request.url.protocol === 'https';",
              "    var has = pm.response.headers.has('Strict-Transport-Security');",
              "    if (https) {",
              "        pm.expect(has, 'thieu HSTS tren ket noi HTTPS').to.be.true;",
              "    } else {",
              "        pm.expect(has, 'khong duoc gui HSTS tren HTTP thuan').to.be.false;",
              "    }",
              "});",
              "pm.test('Không lộ banner phiên bản máy chủ', function () {",
              "    var server = pm.response.headers.get('Server') || '';",
              "    pm.expect(server).to.not.match(/\\d+\\.\\d+/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
