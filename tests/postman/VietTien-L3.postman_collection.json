              "});",
              "pm.test('Không trả toàn bộ bảng sản phẩm', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.totalCount, 'payload OR 1=1 không được khớp mọi dòng').to.be.below(7);",
              "});"
            ],
