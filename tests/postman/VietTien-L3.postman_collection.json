    {
      "name": "L3-ADMC-17 — Swagger phủ hợp đồng API (chỉ chạy ở mode Development)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Case này CHỈ chạy khi server ở ASPNETCORE_ENVIRONMENT=Development",
              "// (Program.cs:293 chỉ bật Swagger ở Development).",
              "if (pm.response.code === 404) {",
              "    pm.test.skip('SKIP: server không chạy ở mode Development nên không có Swagger');",
              "} else {",
              "    pm.test('Trả 200', function () { pm.response.to.have.status(200); });",
              "    var doc = pm.response.json();",
              "    var paths = Object.keys(doc.paths || {});",
              "    pm.test('Swagger mô tả >= 100 route', function () {",
              "        pm.expect(paths.length).to.be.at.least(100);",
              "    });",
              "    pm.test('Có khai báo securityScheme Bearer', function () {",
              "        pm.expect(doc.components.securitySchemes).to.have.property('Bearer');",
              "    });",
              "    var missingResponses = [];",
              "    paths.forEach(function (p) {",
              "        Object.keys(doc.paths[p]).forEach(function (verb) {",
              "            var op = doc.paths[p][verb];",
              "            if (!op.responses || Object.keys(op.responses).length === 0) {",
              "                missingResponses.push(verb.toUpperCase() + ' ' + p);",
              "            }",
              "        });",
              "    });",
              "    pm.test('Mọi operation đều mô tả response', function () {",
              "        pm.expect(missingResponses, missingResponses.join(', ')).to.be.empty;",
              "    });",
              "    console.log('Tong so route trong Swagger: ' + paths.length);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
