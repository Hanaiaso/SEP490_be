# ==============================================================================
# ENVIRONMENT VARIABLES FILE TEMPLATE (.env)
# ==============================================================================
# Hướng dẫn:
# 1. Copy file này thành file .env (hoặc cấu hình trực tiếp trên Server/Docker/Azure)
# 2. Thay thế các giá trị bên dưới bằng thông tin thật của môi trường Production.
# ==============================================================================

# Database
ConnectionStrings__DefaultConnection="Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# CORS / Frontend URL
AllowedOrigins="https://viettien.store,https://www.viettien.store"
AppSettings__FrontendUrl="https://viettien.store"

# JWT Token Secret
JwtSettings__SecretKey="YOUR_SUPER_SECRET_KEY_FOR_JWT_MUST_BE_LONG"

# Email SMTP (Dùng để gửi mail)
EmailSettings__SenderEmail="YOUR_EMAIL@gmail.com"
EmailSettings__SenderPassword="YOUR_APP_PASSWORD"

# SePay (Thanh toán)
SePaySettings__ApiToken="YOUR_SEPAY_API_TOKEN"

# Cloudinary (Lưu trữ ảnh)
CloudinarySettings__CloudName="YOUR_CLOUDINARY_CLOUD_NAME"
CloudinarySettings__ApiKey="YOUR_CLOUDINARY_API_KEY"
CloudinarySettings__ApiSecret="YOUR_CLOUDINARY_API_SECRET"

# eSMS (Gửi tin nhắn)
eSMS__ApiKey="YOUR_ESMS_API_KEY"
eSMS__SecretKey="YOUR_ESMS_SECRET_KEY"
