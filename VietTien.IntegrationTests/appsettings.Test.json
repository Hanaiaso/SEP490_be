{
  // Config cho hạ tầng L2 (SqlServerFixture, UseEnvironment("Test")).
  //
  // File này nằm TRONG project test, không nằm trong VietTien.API, và được nạp tường minh bằng
  // ConfigureAppConfiguration(...AddJsonFile(AppContext.BaseDirectory + "appsettings.Test.json")).
  // Lý do không đặt trong VietTien.API: ràng buộc "không đụng VietTien.API", và tránh việc một file
  // config chỉ dành cho test bị lọt vào output publish của API.
  //
  // Mục đích: KHÔNG nạp appsettings.Development.json nữa — file đó (gitignored) chứa API key THẬT của
  // eSMS/Gemini/Cloudinary, SMTP password thật và URL webhook make.com thật. Chỉ cần một test tương lai
  // quên fake là gọi IO thật ra ngoài.
  //
  // appsettings.json (đã commit) vốn đã để MỌI secret là chuỗi rỗng, nên về lý thuyết chỉ cần
  // JwtSettings:SecretKey là đủ. Vẫn liệt kê lại tất cả ở đây để phòng trường hợp về sau có người
  // commit giá trị thật vào appsettings.json — khi đó file này vẫn ghi đè về rỗng.

  "ConnectionStrings": {
    // Cố tình để rỗng: SqlServerFixture luôn ghi đè bằng connection string của container.
    // Nếu phần ghi đè đó hỏng, test sẽ fail ngay và ồn ào thay vì âm thầm trỏ vào DB dev thật
    // (Server=localhost;Database=VietTien22) — nơi Respawn sẽ xoá sạch dữ liệu.
    "DefaultConnection": ""
  },

  "JwtSettings": {
    // Giá trị GIẢ, chỉ dùng để ký/verify trong test. Phải >= 32 byte cho HMAC-SHA256.
    // Issuer/Audience/ExpiryMinutes kế thừa từ appsettings.json (JSON config merge theo từng key).
    "SecretKey": "IntegrationTestsOnly_FakeSigningKey_DoNotUseInProduction_0123456789"
  },

  "EmailSettings": {
    "SmtpHost": "localhost.invalid",
    "SmtpPort": 25,
    "SenderEmail": "noreply@test.invalid",
    "SenderPassword": "",
    "SenderName": "VietTien Test"
  },

  // ApiKey/SecretKey rỗng -> eSmsService.cs:24 rơi vào nhánh mock, in ra console và trả (true, "")
  // mà KHÔNG gọi HTTP. Đây là lớp phòng vệ thứ hai; lớp thứ nhất là fake ISmsService trong fixture.
  "eSMS": {
    "ApiKey": "",
    "SecretKey": "",
    "Brandname": "TEST"
  },

  // Rỗng -> AiGeneratorService.cs:55 bỏ qua nhánh gọi Gemini.
  "GeminiSettings": {
    "ApiKey": ""
  },

  "CloudinarySettings": {
    "CloudName": "test-invalid",
    "ApiKey": "",
    "ApiSecret": ""
  },

  // WebhookUrl rỗng -> không có endpoint thật nào để POST tới.
  "MakeCom": {
    "WebhookUrl": "",
    "CallbackSecret": ""
  },

  // ApiToken KHÔNG để rỗng (khác các key còn lại): đây là shared secret để xác thực webhook ĐI VÀO,
  // không phải credential gọi ra ngoài — để rỗng thì OrderService.cs:301 so sánh providedToken != ""
  // luôn đúng và MỌI webhook test đều 401, không case nào chạy được. Giá trị giả, không phải token thật.
  "SePaySettings": {
    "ApiToken": "test-sepay-token-not-a-real-secret",
    "BankAccount": "0000000000",
    "BankId": "TEST"
  },

  "GoogleSettings": {
    "ClientId": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
